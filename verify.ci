// verify.ci: ced-verify. Read SHA256SUMS from the directory of its one argument, hash
// every file the manifest lists, and refuse any that is missing, too large, or whose
// digest differs.
//
// The grants decide the only place it can read: fs.read("/arg1"), the directory of the
// argument. A name in the manifest cannot reach outside it, because sums.ci refuses any
// name with a separator and the fs service refuses a path outside its root. Signature
// checking belongs to gpg or pacman, which verify who signed the list; ced-verify checks
// the content, and prints the digest of SHA256SUMS itself so a run can be tied to the
// exact list that was signed.
//
// It fails closed: any line that is not "ok" makes main return an error, so the exit
// status is nonzero and a script that checks it cannot mistake a bad download for a good
// one. assert stays for invariants; a mismatch is an expected outcome, not a program bug.

import sha256;
import sums;
import fs;

requires fs.read("/arg1");

export error VerifyError { parse, missing, mismatch, too_big, io }

// A listed file larger than this is refused, not streamed.
export const I64 FILE_MAX = 16777216;

U8[16384] m;         // the manifest bytes (16 KiB, the most a manifest may be)
U8[8192] dgst;       // sums.MAX_ENTRIES decoded digests of 32 bytes
I64[256] off;        // each name's offset in m
I64[256] nlen;       // each name's length
U8[262] path;        // "/arg1/" plus one name of up to 256 bytes
U8[8192] chunk;      // the read buffer for hashing one file
U8[32] digest;       // the digest of one file
U8[32] mdigest;      // the digest of the manifest itself

// Builds "/arg1/" + m[o..o + n) in path; returns its length.
I64 join_off(I64 o, I64 n) {
    path[0..6] = b"/arg1/";
    for i in 0..n {
        path[6 + i] = m[o + i];
    }
    return 6 + n;
}

// Hash the file at path[0..p) and compare it to entry idx. Returns 0 ok, 1 missing,
// 2 mismatch, 3 too big, 4 cannot read.
I64 hash_file(Grants g, I64 p, I64 idx) {
    I64 fsize = fs.stat(g, path[0..p]) catch (e) {
        if (e == fs.FsError.not_found) {
            return 1;
        }
        return 4;
    };
    if (fsize > FILE_MAX) {
        return 3;
    }
    sha256.Sha256[1] s;
    sha256.sha_init(s);
    I64 at = 0;
    while (true) {
        I64 got = fs.read(g, path[0..p], at, chunk) catch (e) {
            return 4;
        };
        if (got == 0) {
            break;
        }
        sha256.sha_update(s, chunk, 0, got);
        at += got;
    }
    sha256.sha_final(s, digest);
    if (equal(digest, dgst[32 * idx .. 32 * idx + 32])) {
        return 0;
    }
    return 2;
}

export VerifyError!void main(Grants g, in U8[_] args) {
    // One argument: the path to SHA256SUMS. Its last part, after / or \, is the name,
    // read as /arg1/<name>, exactly as ced reads its file.
    I64 nl = len(args) - 1;
    if (nl <= 0 || args[nl] != 0) {
        "ced-verify: give one file: cint run -- verify.ci -- SHA256SUMS\n";
        return .parse;
    }
    I64 start = 0;
    for i in 0..nl {
        if (args[i] == 0) {
            "ced-verify: give one file: cint run -- verify.ci -- SHA256SUMS\n";
            return .parse;
        }
        if (args[i] == '/' || args[i] == '\\') {
            start = i + 1;
        }
    }
    nl -= start;
    if (nl <= 0 || nl > 256) {
        "ced-verify: the name of SHA256SUMS must be 1 to 256 bytes\n";
        return .parse;
    }
    path[0..6] = b"/arg1/";
    for i in 0..nl {
        path[6 + i] = args[start + i];
    }
    I64 mp = 6 + nl;

    I64 ms = fs.stat(g, path[0..mp]) catch (e) {
        if (e == fs.FsError.not_found) {
            "ced-verify: SHA256SUMS is not there\n";
            return .missing;
        }
        return .io;
    };
    if (ms <= 0 || ms > 16384) {
        "ced-verify: SHA256SUMS is empty or larger than 16384 bytes\n";
        return .too_big;
    }
    I64 got = fs.read(g, path[0..mp], 0, m) catch (e) {
        return .io;
    };
    if (got != ms) {
        return .io;
    }
    sha256.sha_digest(m, 0, ms, mdigest);

    I64 c = sums.parse(m, ms, dgst, off, nlen);
    if (c < 0) {
        "ced-verify: SHA256SUMS line {-c} is not a valid entry\n";
        return .parse;
    }

    I64 ok = 0;
    I64 mismatch = 0;
    I64 missing = 0;
    I64 refused = 0;
    for i in 0..c {
        I64 p = join_off(off[i], nlen[i]);
        I64 st = hash_file(g, p, i);
        if (st == 0) {
            "line {i + 1} ok\n";
            ok += 1;
        } else if (st == 1) {
            "line {i + 1} missing\n";
            missing += 1;
        } else if (st == 2) {
            "line {i + 1} mismatch\n";
            mismatch += 1;
        } else {
            "line {i + 1} refused\n";
            refused += 1;
        }
    }

    "{ok} ok, {mismatch} mismatch, {missing} missing, {refused} refused\n";
    "sums sha256 ";
    for i in 0..32 {
        "{mdigest[i]:02x}";
    }
    "\n";

    if (mismatch > 0) {
        return .mismatch;
    }
    if (missing > 0) {
        return .missing;
    }
    if (refused > 0) {
        return .too_big;
    }
}
