// keys.ci: input bytes to keys (SPEC.md KEY-1, KEY-2).
//
// A terminal sends a keystroke as bytes. Letters and other text arrive as their UTF-8 bytes;
// Ctrl plus a letter as one control byte (Ctrl+S is 0x13); and keys with no character, such as
// the arrows, as an escape sequence: ESC, then `[` or `O`, then parameters and a final letter.
// Ctrl+Right in xterm and its descendants is ESC [ 1 ; 5 C: the 5 is a modifier code, 1 plus
// Shift 1, Alt 2 and Ctrl 4.
//
// A key here is one I64: the code point for text, or one of the K_ codes below for a key with
// no character, with the M_ modifier bits on top. `decode` reads one key from a chunk of bytes.

// Modifiers.
export const I64 M_SHIFT = 16777216;     // 1 << 24
export const I64 M_ALT = 33554432;       // 1 << 25
export const I64 M_CTRL = 67108864;      // 1 << 26
export const I64 M_MASK = 117440512;     // all three
// Keys with no character: above the last Unicode code point (0x10FFFF).
export const I64 K_UP = 1114112;
export const I64 K_DOWN = 1114113;
export const I64 K_RIGHT = 1114114;
export const I64 K_LEFT = 1114115;
export const I64 K_HOME = 1114116;
export const I64 K_END = 1114117;
export const I64 K_PGUP = 1114118;
export const I64 K_PGDN = 1114119;
export const I64 K_DELETE = 1114120;
export const I64 K_F3 = 1114121;
export const I64 K_ENTER = 1114122;
export const I64 K_TAB = 1114123;
export const I64 K_BACKSPACE = 1114124;
export const I64 K_ESC = 1114125;
export const I64 K_PASTE = 1114126;      // bracketed paste begins; `paste_len` gives its bytes
export const I64 K_NONE = 1114127;       // a sequence ced does not know: ignored with the bell
export const I64 REPLACEMENT = 65533;    // U+FFFD, for a byte that starts no code point

const U8 ESC = 27;

// The bytes of the code point whose first byte is b, or 0 for a byte that starts none.
I64 utf8_len(U8 b) {
    if (b < 128) {
        return 1;
    }
    if (b >= 194 && b < 224) {
        return 2;
    }
    if (b >= 224 && b < 240) {
        return 3;
    }
    if (b >= 240 && b < 245) {
        return 4;
    }
    return 0;
}

// The modifier bits of an xterm modifier parameter (2 Shift, 3 Alt, 5 Ctrl, 6 Ctrl+Shift, ...).
I64 mods(I64 m) {
    I64 bits = 0;
    I64 v = max(m - 1, 0);
    if (v % 2 == 1) {
        bits += M_SHIFT;
    }
    if ((v / 2) % 2 == 1) {
        bits += M_ALT;
    }
    if ((v / 4) % 2 == 1) {
        bits += M_CTRL;
    }
    return bits;
}

// The key of a CSI or SS3 final letter, or K_NONE.
I64 final_key(U8 f) {
    switch (f) {
        case 'A': return K_UP;
        case 'B': return K_DOWN;
        case 'C': return K_RIGHT;
        case 'D': return K_LEFT;
        case 'H': return K_HOME;
        case 'F': return K_END;
        case 'R': return K_F3;
        default: return K_NONE;
    }
}

// The key of a `CSI n ~` sequence, or K_NONE.
I64 tilde_key(I64 n) {
    switch (n) {
        case 1: return K_HOME;
        case 7: return K_HOME;
        case 4: return K_END;
        case 8: return K_END;
        case 3: return K_DELETE;
        case 5: return K_PGUP;
        case 6: return K_PGDN;
        case 13: return K_F3;
        case 200: return K_PASTE;
        default: return K_NONE;
    }
}

// The key of a single control byte, or of a printable ASCII byte.
I64 byte_key(U8 b) {
    if (b == 13 || b == 10) {
        return K_ENTER;
    }
    if (b == 9) {
        return K_TAB;
    }
    if (b == 127 || b == 8) {
        return K_BACKSPACE;
    }
    if (b == 31) {
        return M_CTRL + '/';                 // xterm sends 0x1F for Ctrl+/
    }
    if (b >= 1 && b <= 26) {
        return M_CTRL + ('a' + (b as I64) - 1);
    }
    if (b < 32) {
        return K_NONE;
    }
    return b as I64;
}

// Reads one key from b at i. Writes the key to res[0] and returns how many bytes it took, or 0
// when b ends inside a key, so the caller keeps those bytes for the next chunk. A lone ESC at the
// end of the chunk is Esc (KEY-2).
export I64 decode(in U8[_] b, I64 i, inout I64[_] res) {
    I64 n = len(b);
    U8 c = b[i];
    if (c != ESC) {
        I64 k = utf8_len(c);
        if (k == 0) {
            res[0] = REPLACEMENT;
            return 1;
        }
        if (k == 1) {
            res[0] = byte_key(c);
            return 1;
        }
        if (i + k > n) {
            return 0;
        }
        I64 cp = (c as I64) % (128 >> k);
        for j in 1..k {
            cp = cp * 64 + (b[i + j] as I64) % 64;
        }
        res[0] = cp;
        return k;
    }
    if (i + 1 == n) {
        res[0] = K_ESC;
        return 1;
    }
    U8 c1 = b[i + 1];
    if (c1 == 'O') {
        if (i + 2 == n) {
            return 0;
        }
        res[0] = final_key(b[i + 2]);
        return 3;
    }
    if (c1 != '[') {
        // ESC then a key: Alt and that key.
        I64[2] inner;
        I64 used = decode(b, i + 1, inner);
        if (used == 0) {
            return 0;
        }
        res[0] = inner[0] + M_ALT;
        return used + 1;
    }
    // CSI: ESC [ then numbers separated by `;`, then a final byte.
    I64 p0 = 0;
    I64 p1 = 0;
    I64 which = 0;
    I64 j = i + 2;
    while (j < n && ((b[j] >= '0' && b[j] <= '9') || b[j] == ';')) {
        if (b[j] == ';') {
            which += 1;
        } else if (which == 0) {
            p0 = p0 * 10 + (b[j] as I64) - '0';
        } else if (which == 1) {
            p1 = p1 * 10 + (b[j] as I64) - '0';
        }
        j += 1;
    }
    if (which == 0) {
        p1 = 1;                                  // no modifier parameter: none held
    }
    if (j == n) {
        return 0;
    }
    U8 f = b[j];
    I64 key = K_NONE;
    if (f == '~') {
        key = tilde_key(p0);
    } else if (f == 'Z') {
        key = K_TAB + M_SHIFT;
    } else {
        key = final_key(f);
    }
    if (key != K_NONE && key != K_PASTE) {
        key += mods(p1);
    }
    res[0] = key;
    return j - i + 1;
}

// The bytes of a bracketed paste from b at i, up to its closing ESC [ 2 0 1 ~ or the end of the
// chunk. Writes 1 to res[0] when the closing sequence was found (and is included in the count),
// else 0, so the caller knows the paste goes on in the next chunk.
export I64 paste_len(in U8[_] b, I64 i, inout I64[_] res) {
    I64 n = len(b);
    I64 j = i;
    while (j + 6 <= n) {
        if (b[j] == ESC && b[j + 1] == '[' && b[j + 2] == '2' && b[j + 3] == '0' && b[j + 4] == '1' && b[j + 5] == '~') {
            res[0] = 1;
            return j - i + 6;
        }
        j += 1;
    }
    res[0] = 0;
    return n - i;
}

// Whether b is valid UTF-8 (shortest forms, no surrogates, nothing above U+10FFFF).
export Bool valid_utf8(in U8[_] b) {
    I64 n = len(b);
    I64 i = 0;
    while (i < n) {
        I64 k = utf8_len(b[i]);
        if (k == 0 || i + k > n) {
            return false;
        }
        I64 cp = (b[i] as I64) % (128 >> k);
        if (k == 1) {
            cp = b[i] as I64;
        }
        for j in 1..k {
            if (b[i + j] < 128 || b[i + j] >= 192) {
                return false;
            }
            cp = cp * 64 + (b[i + j] as I64) % 64;
        }
        if ((k == 3 && cp < 2048) || (k == 4 && cp < 65536) || cp > 1114111 || (cp >= 55296 && cp < 57344)) {
            return false;
        }
        i += k;
    }
    return true;
}

// Writes the UTF-8 bytes of code point cp to s and returns how many (1 to 4).
export I64 encode(I64 cp, inout U8[_] s) {
    if (cp < 128) {
        s[0] = cp as U8;
        return 1;
    }
    if (cp < 2048) {
        s[0] = (192 + cp / 64) as U8;
        s[1] = (128 + cp % 64) as U8;
        return 2;
    }
    if (cp < 65536) {
        s[0] = (224 + cp / 4096) as U8;
        s[1] = (128 + (cp / 64) % 64) as U8;
        s[2] = (128 + cp % 64) as U8;
        return 3;
    }
    s[0] = (240 + cp / 262144) as U8;
    s[1] = (128 + (cp / 4096) % 64) as U8;
    s[2] = (128 + (cp / 64) % 64) as U8;
    s[3] = (128 + cp % 64) as U8;
    return 4;
}

test "encode is decode's inverse" {
    U8[4] s;
    I64[2] k;
    assert(encode(233, s) == 2);
    assert(decode(s[0..2], 0, k) == 2 && k[0] == 233);
    assert(encode(128512, s) == 4);
    assert(decode(s, 0, k) == 4 && k[0] == 128512);
}

test "text and control bytes" {
    I64[2] k;
    U8[3] b = b"a\x13\r";
    assert(decode(b, 0, k) == 1);
    assert(k[0] == 'a');
    assert(decode(b, 1, k) == 1);
    assert(k[0] == M_CTRL + 's');
    assert(decode(b, 2, k) == 1);
    assert(k[0] == K_ENTER);
}

test "a two-byte code point, and one split across chunks" {
    I64[2] k;
    U8[2] e = b"\xc3\xa9";
    assert(decode(e, 0, k) == 2);
    assert(k[0] == 233);
    U8[1] half = b"\xc3";
    assert(decode(half, 0, k) == 0);
}

test "arrows, with and without modifiers" {
    I64[2] k;
    U8[3] up = b"\x1b[A";
    assert(decode(up, 0, k) == 3);
    assert(k[0] == K_UP);
    U8[6] cr = b"\x1b[1;5C";
    assert(decode(cr, 0, k) == 6);
    assert(k[0] == K_RIGHT + M_CTRL);
    U8[6] sd = b"\x1b[1;2B";
    assert(decode(sd, 0, k) == 6);
    assert(k[0] == K_DOWN + M_SHIFT);
    U8[3] ss3 = b"\x1bOH";
    assert(decode(ss3, 0, k) == 3);
    assert(k[0] == K_HOME);
}

test "tilde keys and a sequence cut off at the end" {
    I64[2] k;
    U8[4] del = b"\x1b[3~";
    assert(decode(del, 0, k) == 4);
    assert(k[0] == K_DELETE);
    U8[3] cut = b"\x1b[3";
    assert(decode(cut, 0, k) == 0);
}

test "a lone ESC is Esc, ESC then a letter is Alt" {
    I64[2] k;
    U8[1] e = b"\x1b";
    assert(decode(e, 0, k) == 1);
    assert(k[0] == K_ESC);
    U8[2] ax = b"\x1bx";
    assert(decode(ax, 0, k) == 2);
    assert(k[0] == 'x' + M_ALT);
}

test "a bracketed paste and its end" {
    I64[2] k;
    U8[14] p = b"\x1b[200~hi\x1b[201~";
    assert(decode(p, 0, k) == 6);
    assert(k[0] == K_PASTE);
    assert(paste_len(p, 6, k) == 8);
    assert(k[0] == 1);
}
